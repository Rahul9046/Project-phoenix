# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored: workspaces put these under apps/* as well as at the root.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds variable names and no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch previews served through public/ during development.
# Regenerate one from the real template with scripts/preview-email.sh
apps/web/public/__*

# Supplied demo photographs. Generated portraits only -- never a real person.
# The folder's instructions are tracked; the images are not.
scripts/demo-photos/*
!scripts/demo-photos/README.md

# Dropped at the repository root by running Expo from here, which is how the
# root scripts start the app (`npm run mobile`). `apps/mobile/.gitignore`
# already covers the copies inside the app; these are the stray ones.
# `devices.json` is this machine's simulator list, and the root `tsconfig.json`
# is a stub extending `expo/tsconfig.base` -- neither describes the monorepo,
# whose real configs live in `apps/web` and `apps/mobile`.
/.expo/
/tsconfig.json

# Cloudflare Workers build output, produced by @opennextjs/cloudflare.
.open-next/

# Wrangler local runtime secrets. Never committed.
.dev.vars
.dev.vars.*

# Wrangler local state.
.wrangler/

# Build review packages. Generated on demand by `npm run review:package`;
# regenerate rather than commit, so a stale package cannot be mistaken for
# the current build. The generator and its docs ARE tracked.
artifacts/
