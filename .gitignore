# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# Unanchored: workspaces put these under apps/* as well as at the root.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which holds variable names and no values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch previews served through public/ during development.
# Regenerate one from the real template with scripts/preview-email.sh
apps/web/public/__*

# Supplied demo photographs. Generated portraits only -- never a real person.
# The folder's instructions are tracked; the images are not.
scripts/demo-photos/*
!scripts/demo-photos/README.md
