{
  "name": "eraya",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @eraya/web",
    "build": "npm run build --workspace @eraya/web",
    "start": "npm run start --workspace @eraya/web",
    "lint": "npm run lint --workspace @eraya/web",
    "mobile": "npm run start --workspace @eraya/mobile",
    "mobile:android": "npm run android --workspace @eraya/mobile",
    "mobile:ios": "npm run ios --workspace @eraya/mobile",
    "mobile:lint": "npm run lint --workspace @eraya/mobile",
    "typecheck": "npm run typecheck --workspace @eraya/mobile && tsc --noEmit -p apps/web",
    "i18n:check": "node packages/i18n/scripts/check-locales.mjs",
    "locale:probe": "node scripts/locale-probe.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:remove": "node scripts/demo-seed.mjs --remove",
    "seed:profile": "node scripts/seed-profile.mjs",
    "seed:profile:dry": "node scripts/seed-profile.mjs --dry-run",
    "seed:list": "node scripts/seed-profile.mjs --list",
    "seed:remove": "node scripts/seed-profile.mjs --remove",
    "security": "node scripts/security-probe.mjs",
    "auth:capacity": "node scripts/auth-capacity.mjs",
    "payments:probe": "node scripts/payments-probe.mjs",
    "config:push": "node scripts/supabase-config.mjs",
    "review:package": "node scripts/review-package.mjs",
    "review:package:fast": "node scripts/review-package.mjs --skip-checks",
    "moderation:probe": "node scripts/moderation-probe.mjs",
    "photos:sweep": "node scripts/photo-sweep.mjs",
    "analytics:probe": "node scripts/analytics-probe.mjs",
    "activity:probe": "node scripts/activity-probe.mjs",
    "religion:probe": "node scripts/religion-probe.mjs",
    "seo:probe": "node scripts/seo-probe.mjs",
    "positioning:probe": "node scripts/positioning-probe.mjs",
    "ios:probe": "node scripts/ios-probe.mjs",
    "ios:probe:fast": "node scripts/ios-probe.mjs --fast",
    "test": "node --no-warnings --test \"apps/web/src/**/*.test.ts\" \"apps/mobile/src/**/*.test.ts\"",
    "play:channel": "node scripts/play-channel.mjs",
    "framing:probe": "node --no-warnings scripts/framing-probe.mjs",
    "phone:probe": "node scripts/phone-limits-probe.mjs",
    "age:check": "node --no-warnings scripts/age-eligibility-check.mjs"
  }
}
