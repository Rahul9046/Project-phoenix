# Eraya environment variables.
#
# Copy this file to .env.local and fill in the values from the Supabase
# dashboard. .env.local is git-ignored and must stay that way — see
# docs/08-backend.md for where each value comes from.
#
# Variable NAMES only in this file. Never commit a real key.

# ---------------------------------------------------------------------------
# Supabase — public
# ---------------------------------------------------------------------------
# Safe to expose to the browser. The key identifies the project; Row Level
# Security is what protects the data.
#
# Dashboard: Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=

# Newer projects issue a publishable key (sb_publishable_...). Set this one.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Older projects issue a classic anon JWT instead. Set this one *only* if your
# project has no publishable key. The application accepts either.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — secret (server only)
# ---------------------------------------------------------------------------
# Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_, never send to
# the browser, never commit. Nothing in the member-facing app uses it; it is
# for administrative work such as reading the waitlist.

SUPABASE_SECRET_KEY=

# Classic equivalent, if your project predates secret keys.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin OAuth providers redirect back to. Defaults to
# http://localhost:3000 when unset. Set it in production.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# OAuth provider credentials
# ---------------------------------------------------------------------------
# Read by supabase/config.toml and applied to the linked project with
# `supabase config push`. They are NOT only for local development -- that note
# used to say so and was wrong once config push became how this project is
# configured.
#
# A provider must not be switched on in config.toml until its credentials are
# here. lib/data/auth-settings.ts renders a button for whatever the live project
# reports as enabled, so enabling one without a client id puts a button on the
# login screen that ejects people onto a raw JSON error page.
#
# Google: console.cloud.google.com -> APIs & Services -> Credentials -> OAuth
# client ID (Web application). Authorised redirect URI must be
# https://<project-ref>.supabase.co/auth/v1/callback

SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
# SUPABASE_AUTH_APPLE_CLIENT_ID=
# SUPABASE_AUTH_APPLE_SECRET=
# SUPABASE_AUTH_FACEBOOK_CLIENT_ID=
# SUPABASE_AUTH_FACEBOOK_SECRET=

# ---------------------------------------------------------------------------
# Custom SMTP (Supabase Auth) -- Resend
#
# Required before anyone outside the Supabase project can receive a sign-in
# code, and before the branded email template can be applied at all.
#
# There are TWO restrictions to clear, and only the first is obvious:
#
#   1. Supabase's built-in email service delivers solely to members of the
#      project. Configuring SMTP at all lifts that.
#
#   2. Resend itself only delivers to the address the Resend account was
#      created with until a sending domain is verified. This is the usual cause
#      of "authentication only works for the developer's email" -- there is no
#      allow-list in this repository and never has been. Verify eraya.app in
#      Resend -> Domains and confirm every DNS record reads Verified.
#
# The sender is no-reply@eraya.app (supabase/config.toml). It must be on the
# verified domain; the mailbox itself never receives anything.
#
# HOST is smtp.resend.com and USER is the literal word `resend`. PASS is a
# Resend API key -- a send-only key is correct and sufficient.
# ---------------------------------------------------------------------------
SUPABASE_SMTP_HOST=smtp.resend.com
SUPABASE_SMTP_USER=resend
SUPABASE_SMTP_PASS=

# ---------------------------------------------------------------------------
# MSG91 -- phone verification (SERVER ONLY)
# ---------------------------------------------------------------------------
# These are NOT read by the web app or the mobile app. They are set as Supabase
# edge function secrets and exist here only so the names are written down in one
# place:
#
#   supabase secrets set MSG91_AUTH_KEY=... MSG91_TEMPLATE_ID=...
#
# An SMS costs money to send, so an auth key in a client bundle is somebody
# else's SMS campaign paid for by Eraya. Never prefix either with NEXT_PUBLIC_
# or EXPO_PUBLIC_, and never read them outside supabase/functions/.
#
# MSG91_AUTH_KEY     Dashboard -> Settings -> API keys
# MSG91_TEMPLATE_ID  Dashboard -> OTP -> the approved OTP template's id
#
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
#
# OTP_DEV_CODE  -- development only, and a deliberate hole while it is set.
#
# Sending a transactional SMS in India needs DLT registration: a business
# entity, PAN, GST, and days of approval. Until that is in place, setting this
# to six digits makes the OTP functions send nothing and accept that one code.
#
# It is not the old mock. A random guess still fails, the code is a server
# secret rather than a rule anybody can read off the screen, and every limit --
# cooldown, daily caps, attempt cap, unique verified number -- still runs.
#
# Every call using it logs `provider: "stub"`. Unset the secret and the same
# code path calls MSG91; there is no release involved.
#
#   npx supabase secrets set OTP_DEV_CODE=424242
#   npx supabase secrets unset OTP_DEV_CODE      # before real members arrive
