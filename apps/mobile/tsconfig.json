{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    /*
     * So `framing-gestures.ts` can import `./framing.ts` by its real name.
     * `scripts/framing-probe.mjs` loads that module with Node, which resolves
     * neither the `@/` alias nor an extensionless path -- and gesture maths
     * nobody can run a check against is how the crop broke in the first place.
     */
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  /*
   * `*.test.ts` is run by `node --test` from the repository root, which strips
   * types rather than checking them, and the files import `node:test` and
   * `node:assert`. Checking them here would mean adding `@types/node` to a
   * React Native project, and that brings Node's `setTimeout` -- which returns
   * a `Timeout` object rather than RN's `number` -- into every file that uses a
   * timer. The tests are deliberately pure modules with no React Native import,
   * so the cost of not type-checking them is small and the cost of the
   * alternative is spread across the whole app.
   */
  "exclude": ["**/*.test.ts"]
}
