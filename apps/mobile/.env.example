# Copy to .env.local and fill in from the Supabase dashboard (Settings -> API).
# Both values are public: RLS is what protects the data, not these.
# NEVER put the service role / secret key in this app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the website is. Premium checkout opens `<this>/checkout` in the browser:
# Supabase will not serve HTML from an edge function on its own domain. From an
# Android emulator, localhost reaches the dev server via `adb reverse tcp:3000`.
EXPO_PUBLIC_SITE_URL=

# Which way this build is distributed, and therefore who takes the money.
# `play` is the build uploaded to Google Play and is the ONLY value that turns
# Google Play Billing on. Anything else -- including leaving this unset -- means
# `direct`: the APK handed out from eraya.app, which is sideloaded rather than
# distributed by Play and keeps the Razorpay browser checkout.
#
# Leave it unset locally. The EAS profiles declare it (`play` in eas.json sets
# `play`; every other profile sets `direct`), and the local Gradle release build
# for the public APK needs nothing here because absent already means `direct`.
# Never set `play` for a build that is not going to Play: a Play Billing client
# cannot connect in an install Play did not distribute, and the only symptom is
# a member who cannot pay. iOS ignores this entirely -- Premium is not for sale
# there at all. See docs/10-payments.md and docs/14-google-play.md.
EXPO_PUBLIC_DISTRIBUTION=
